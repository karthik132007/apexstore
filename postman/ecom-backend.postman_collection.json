{
  "info": {
    "name": "E-Commerce Backend — Project 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against http://localhost:8080. Creates demo data. Set admin credentials privately. Seller enablement returns a new token. Backend only."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@ecom.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": "Local-demo-password-123"
    }
  ],
  "item": [
    {
      "name": "1. Register seller",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Seller\",\n  \"email\": \"seller-{{runId}}@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId',Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('sellerToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Enable selling — replace token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/users/me/seller",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('sellerToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/seller/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"POSTMAN-{{runId}}\",\n  \"name\": \"Demo keyboard\",\n  \"description\": \"Academic API demo\",\n  \"category\": \"Electronics\",\n  \"price\": 499.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('productId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Set stock",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/seller/products/{{productId}}/stock",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stockOnHand\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Browse products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products?page=0&size=10&sort=price,asc"
      }
    },
    {
      "name": "6. Register buyer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Buyer\",\n  \"email\": \"buyer-{{runId}}@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('buyerToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Place order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Buyer\",\n  \"customerEmail\": \"buyer-{{runId}}@example.test\",\n  \"address\": \"Academic demo address\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order accepted',()=>pm.expect([200,202]).to.include(pm.response.code));",
              "pm.collectionVariables.set('orderId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Read order — wait for CONFIRMED",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "9. Generate SOAP-backed invoice",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}/invoice",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invoice generated',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Get invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders/{{orderId}}/invoice",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. Order history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orders?page=0&size=10&sort=createdAt,desc",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{buyerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "12. Seller listings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/seller/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "13. Admin login — set private credentials first",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200) pm.collectionVariables.set('adminToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Admin listings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
